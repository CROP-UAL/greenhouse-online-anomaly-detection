#!/bin/sh
# Install locally with: git config --local core.hooksPath .githooks
if [ -x .venv/bin/python ]; then
    exec .venv/bin/python -m shared.reporting.check_push --pre-push
elif [ -x .venv/Scripts/python.exe ]; then
    exec .venv/Scripts/python.exe -m shared.reporting.check_push --pre-push
elif command -v python3 >/dev/null 2>&1; then
    exec python3 -m shared.reporting.check_push --pre-push
elif command -v python >/dev/null 2>&1; then
    exec python -m shared.reporting.check_push --pre-push
else
    echo 'PUSH BLOCKED: Python is required for the repository pre-push audit.' >&2
    exit 1
fi
